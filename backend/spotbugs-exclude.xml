<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!--
      Spring dependency injection stores bean references by design; EI_EXPOSE_REP*
      warnings on injected collaborators are noise. Limited to our config/security
      wiring rather than excluded globally.
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Or>
            <Class name="com.bidwise.config.SecurityConfig"/>
            <Class name="com.bidwise.common.security.JwtAuthenticationFilter"/>
            <Class name="com.bidwise.auth.AuthService"/>
            <Class name="com.bidwise.auth.AuthController"/>
            <Class name="com.bidwise.listing.ListingService"/>
            <Class name="com.bidwise.listing.ListingController"/>
            <Class name="com.bidwise.listing.AuctionCloseService"/>
            <Class name="com.bidwise.listing.AuctionCloseScheduler"/>
            <Class name="com.bidwise.bid.BidService"/>
            <Class name="com.bidwise.bid.BidController"/>
            <Class name="com.bidwise.bid.AtomicBidPrice"/>
            <Class name="com.bidwise.realtime.ListingBroadcaster"/>
            <Class name="com.bidwise.payment.DepositService"/>
            <Class name="com.bidwise.payment.SettlementService"/>
            <Class name="com.bidwise.payment.WebhookService"/>
            <Class name="com.bidwise.payment.PaymentController"/>
            <Class name="com.bidwise.payment.StripeWebhookController"/>
            <Class name="com.bidwise.payment.FakePaymentGateway"/>
            <Class name="com.bidwise.payment.StripePaymentGateway"/>
        </Or>
    </Match>

    <!--
      JPA entities deliberately return their managed associations/collections (a
      defensive copy would detach them from the persistence context), and our DTO
      records are immutable data carriers. EI_EXPOSE* on these is framework noise.
    -->
    <Match>
        <Or>
            <Bug pattern="EI_EXPOSE_REP"/>
            <Bug pattern="EI_EXPOSE_REP2"/>
        </Or>
        <Or>
            <Class name="com.bidwise.listing.Listing"/>
            <Class name="com.bidwise.listing.dto.CreateListingRequest"/>
            <Class name="com.bidwise.listing.dto.UpdateListingRequest"/>
            <Class name="com.bidwise.listing.dto.ListingResponse"/>
            <Class name="com.bidwise.listing.dto.ListingPageResponse"/>
            <Class name="com.bidwise.bid.Bid"/>
            <Class name="com.bidwise.bid.dto.BidResponse"/>
            <Class name="com.bidwise.bid.dto.BidPageResponse"/>
            <Class name="com.bidwise.realtime.BidEvent"/>
            <Class name="com.bidwise.payment.PaymentHold"/>
            <Class name="com.bidwise.payment.Settlement"/>
            <Class name="com.bidwise.payment.dto.PaymentHoldResponse"/>
        </Or>
    </Match>

    <!--
      JwtService validates its secret in the constructor (Keys.hmacShaKeyFor may
      throw for a too-short key). Fail-fast at startup is intended.
    -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
        <Class name="com.bidwise.common.security.JwtService"/>
    </Match>
</FindBugsFilter>
