# Copy to backend/.env and adjust. Do NOT commit backend/.env.
# Consumed by the backend service AND the postgres service in docker-compose
# (the backend owns the database, so DB credentials live here).

# Postgres
POSTGRES_DB=bidwise
POSTGRES_USER=bidwise
POSTGRES_PASSWORD=bidwise_dev_pw

# Backend datasource (host points at the compose service name)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/bidwise
SPRING_DATASOURCE_USERNAME=bidwise
SPRING_DATASOURCE_PASSWORD=bidwise_dev_pw
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379

# JWT (HS256). Use a long random string in real envs (min 32 bytes for HS256).
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
JWT_EXPIRATION_MS=86400000

# Payments (P3). Default gateway is "fake" (in-memory holds, no external service) so the
# stack runs out of the box. Set to "stripe" with test-mode keys to use real Stripe.
PAYMENT_GATEWAY=fake
PAYMENT_DEPOSIT_FRACTION=0.10
PAYMENT_CURRENCY=eur
# Only needed when PAYMENT_GATEWAY=stripe (use Stripe TEST-mode keys).
PAYMENT_STRIPE_SECRET_KEY=
PAYMENT_STRIPE_WEBHOOK_SECRET=
